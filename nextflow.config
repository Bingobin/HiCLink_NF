manifest {
    name            = 'HiCLink_NF'
    author          = 'Yabin Liu'
    homePage        = 'https://github.com/'
    description     = 'Unified, modular analysis of Hi-C and HiChIP sequencing data'
    license         = 'GPL-3.0-only'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}

params {
    input                    = "${projectDir}/assets/samplesheet.example.csv"
    outdir                   = 'results'
    publish_mode             = 'copy'
    memory_per_cpu_gb        = 4

    fasta                    = null
    chrom_sizes              = null
    genome                   = 'custom'
    phasing_track            = null
    phasing_track_column     = null

    base_resolution          = 5000
    resolutions              = '5000,10000,25000,50000,100000,250000,500000,1000000'
    analysis_resolution      = 10000
    compartment_resolution   = 100000
    loop_resolution          = 10000
    tad_windows              = '100000,250000,500000'

    min_mapq                 = 30
    walks_policy             = '5unique'
    dedup_max_mismatch       = 3
    balance_ignore_diags     = 2

    run_fastqc               = true
    skip_trimming            = false
    fastp_extra_args         = ''
    save_trimmed             = false
    save_alignment_bam       = false
    save_pairs               = true

    run_contact_qc           = true
    run_expected             = true
    global_features_all_assays = false
    run_compartments         = true
    compartment_n_eigs       = 3
    run_tads                 = true
    insulation_threshold     = 'Li'

    run_hic_loops            = true
    dots_all_assays          = false
    min_loop_distance        = 20000
    max_loop_distance        = 2000000

    run_hichip_peaks         = true
    macs2_genome_size        = null
    macs2_qvalue             = 0.01
    macs2_extra_args         = ''

    run_fithichip                    = true
    fithichip_command                = 'FitHiChIP_HiCPro.sh'
    fithichip_interaction_type       = 3
    fithichip_use_p2p_background     = 0
    fithichip_bias_type              = 1
    fithichip_merge_interactions     = 1
    fithichip_qvalue                 = 0.01

    run_multiqc              = true
    multiqc_config           = "${projectDir}/assets/multiqc_config.yml"
}

process {
    executor = 'local'

    cpus   = 2
    memory = { (params.memory_per_cpu_gb as Integer).GB * task.cpus }
    time   = 4.h

    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 1

    withLabel: small {
        cpus   = 2
        memory = { (params.memory_per_cpu_gb as Integer).GB * task.cpus }
        time   = 2.h
    }
    withLabel: medium {
        cpus   = 8
        memory = { (params.memory_per_cpu_gb as Integer).GB * task.cpus }
        time   = 12.h
    }
    withLabel: large {
        cpus   = 16
        memory = { (params.memory_per_cpu_gb as Integer).GB * task.cpus }
        time   = 48.h
    }
    withLabel: xlarge {
        cpus   = 24
        memory = { (params.memory_per_cpu_gb as Integer).GB * task.cpus }
        time   = 72.h
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
        conda.useMamba = true
        process {
            conda = "${projectDir}/envs/hiclink.yml"
            withName: FITHICHIP {
                conda = null
            }
        }
    }

    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
    }

    docker_fithichip {
        docker.enabled = true
        params.fithichip_command = '/FitHiChIP/FitHiChIP_HiCPro.sh'
        process {
            withName: FITHICHIP {
                container = 'aylab/fithichip:latest'
            }
        }
    }

    apptainer_fithichip {
        apptainer.enabled = true
        apptainer.autoMounts = true
        params.fithichip_command = '/FitHiChIP/FitHiChIP_HiCPro.sh'
        process {
            withName: FITHICHIP {
                container = 'docker://aylab/fithichip:latest'
            }
        }
    }

    test {
        params.input = "${projectDir}/tests/data/samplesheet.csv"
        params.fasta = "${projectDir}/tests/data/tiny.fa"
        params.chrom_sizes = "${projectDir}/tests/data/tiny.chrom.sizes"
        params.genome = 'tiny'
        params.resolutions = '10,20,50,100'
        params.base_resolution = 10
        params.analysis_resolution = 10
        params.compartment_resolution = 100
        params.loop_resolution = 10
        params.tad_windows = '20,50'
        params.phasing_track = "${projectDir}/tests/data/tiny.phasing.bedgraph"
        params.phasing_track_column = 'GC'
        params.global_features_all_assays = true
        params.run_compartments = true
        params.run_hic_loops = true
        params.run_fithichip = true
        params.run_multiqc = true
        params.outdir = 'results_test'
        process {
            withLabel: small {
                cpus = 1
                memory = 1.GB
                time = 10.m
            }
            withLabel: medium {
                cpus = 1
                memory = 1.GB
                time = 10.m
            }
            withLabel: large {
                cpus = 1
                memory = 1.GB
                time = 10.m
            }
            withLabel: xlarge {
                cpus = 1
                memory = 1.GB
                time = 10.m
            }
        }
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
