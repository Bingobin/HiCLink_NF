// Separate output version: never reuse the previous cLoops2/Mustache output directory.
includeConfig 'hichip_loops.config'

params {
    input = '/analysis/pipeline_info/samplesheet.validated.csv'
    previous_results = '/analysis'
    outdir = '/analysis/06_hichip/loops/results_nf/v2_fithichip_10kb'
    hichip_loop_outdir = params.outdir
    hichip_loops_env = '/path/to/conda/envs/hiclink'
    hichip_loop_callers = 'fithichip'
    loop_resolution = 10000
    min_loop_distance = 20000
    max_loop_distance = 2000000
    fithichip_loop_cpus = 2
    fithichip_loop_memory_gb = 6
}

includeConfig 'hichip_loops_runtime.config'
