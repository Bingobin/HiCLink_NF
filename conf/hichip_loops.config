// Opt-in configuration for hichip_loops.nf; the existing FASTQ entry point is unchanged.
params {
    help = false
    hichip_loop_callers = 'cloops2,mustache'
    hichip_loop_diff = true
    hichip_loop_chroms = 'chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX'
    hichip_loop_cpus = 2
    hichip_loop_outdir = "${params.outdir}/06_hichip/loops"
    hichip_loops_env = null
    cloops2_eps = '5000,10000'
    cloops2_minpts = '10'
    cloops2_diff_pcut = 0.01
    cloops2_diff_ma_fdr = 0.1
    mustache_pt = 0.05
    mustache_diff_pt = 0.05
    mustache_sparsity = 0.88
    loop_balance_max_iters = 1000
    fithichip_loop_image = 'hiclink/fithichip:11-0ea1ac2'
    fithichip_loop_platform = 'linux/amd64'
    fithichip_loop_cpus = 2
    fithichip_loop_memory_gb = 6
    fithichip_loop_qvalue = 0.01
    fithichip_loop_background_fdr = 1.0
    fithichip_loop_diff_fdr = 0.05
    fithichip_loop_fold_change = 2
    fithichip_loop_bcv = 0.4
    fithichip_loop_interaction_type = 3
    fithichip_loop_p2p_background = 0
    fithichip_loop_bias_type = 1
}

process {
    withLabel: hichip_loop_fithichip {
        cpus = { params.fithichip_loop_cpus as Integer }
        memory = { (params.fithichip_loop_memory_gb as Integer).GB }
        time = 24.h
        errorStrategy = 'terminate'
        shell = ['/bin/bash', '-euo', 'pipefail']
    }
    withLabel: hichip_loop_qc {
        cpus = 1
        memory = { (params.memory_per_cpu_gb as Integer).GB * task.cpus }
        time = 1.h
        errorStrategy = 'terminate'
        shell = ['/bin/bash', '-euo', 'pipefail']
    }
    withLabel: hichip_loop_analysis {
        cpus = params.hichip_loop_cpus as Integer
        memory = { (params.memory_per_cpu_gb as Integer).GB * task.cpus }
        time = 24.h
        errorStrategy = 'terminate'
        shell = ['/bin/bash', '-euo', 'pipefail']
    }
    // Cache/font writes must stay in the task directory, including on worker nodes.
    withName: '.*(LOOP_INPUT_QC|CLOOPS_PRE|CLOOPS_CALL|CLOOPS_DIFF|MUSTACHE_PREPARE|MUSTACHE_CALL|MUSTACHE_DIFF|DISCOVER_LOOP_INPUTS|FITHICHIP_.*)' {
        beforeScript = '''
            export MPLBACKEND=Agg PYTHONNOUSERSITE=1
            export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
            export MPLCONFIGDIR="$PWD/.cache/matplotlib"
            mkdir -p "$MPLCONFIGDIR"
        '''
    }
}

profiles {
    hichip_loops_local {
        process.executor = 'local'
        // Let Nextflow schedule tasks against detected CPU/RAM and their resource requests.
        process {
            withName: '.*(LOOP_INPUT_QC|CLOOPS_PRE|CLOOPS_CALL|CLOOPS_DIFF|MUSTACHE_PREPARE|MUSTACHE_CALL|MUSTACHE_DIFF|DISCOVER_LOOP_INPUTS|FITHICHIP_.*)' {
                conda = null
                container = null
                beforeScript = {
                    def prefix = params.hichip_loops_env
                        ? "export PATH='${params.hichip_loops_env.toString().replace("'", "'\"'\"'")}/bin':\"\$PATH\"\n"
                        : ''
                    prefix + '''
                        export MPLBACKEND=Agg PYTHONNOUSERSITE=1
                        export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
                        export MPLCONFIGDIR="$PWD/.cache/matplotlib"
                        mkdir -p "$MPLCONFIGDIR"
                    '''
                }
            }
        }
    }
}
