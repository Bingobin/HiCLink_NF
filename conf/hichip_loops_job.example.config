// Copy to hichip_loops_job.local.config and edit paths before running.
// Keep includes in this order so report paths see the final job parameters.
includeConfig 'hichip_loops.config'

params {
    input = '/analysis/HiChIP_analysis/pipeline_info/samplesheet.validated.csv'
    previous_results = '/analysis/HiChIP_analysis'
    outdir = 'results_loops'
    hichip_loop_outdir = params.outdir
    // Null means use tools already available in PATH; otherwise set the Conda prefix.
    hichip_loops_env = null
}

includeConfig 'hichip_loops_runtime.config'
