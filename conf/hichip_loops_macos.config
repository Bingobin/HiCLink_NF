// Late-bound analysis resources and cLoops2 compatibility; reusable by a parent workflow.
process {
    withLabel: hichip_loop_analysis {
        // The base config is loaded before job overrides; do not freeze its default CPU count.
        cpus = { params.hichip_loop_cpus as Integer }
    }
}

profiles {
    hichip_loops_local {
        process {
            withName: '.*CLOOPS_CALL' {
                // cLoops2 0.0.3 initializes logger/DBSCAN globals only in the parent.
                // macOS spawn workers lose those globals; -p 1 avoids the broken path.
                // Do not force fork or patch the installed Python package.
                cpus = {
                    System.getProperty('os.name').toLowerCase().contains('mac')
                        ? 1
                        : (params.hichip_loop_cpus as Integer)
                }
            }
        }
    }
}
