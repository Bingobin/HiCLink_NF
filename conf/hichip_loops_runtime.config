// Include LAST in ONE ordered config graph, after project and machine/job settings.
// Separate -c files do not reliably share parameter interpolation during parsing.
// This report rebinding is for the standalone loop entry, not the full parent run.
includeConfig 'hichip_loops_macos.config'

timeline.file = "${params.hichip_loop_outdir}/pipeline_info/execution_timeline.html"
report.file = "${params.hichip_loop_outdir}/pipeline_info/execution_report.html"
trace.file = "${params.hichip_loop_outdir}/pipeline_info/execution_trace.txt"
dag.file = "${params.hichip_loop_outdir}/pipeline_info/pipeline_dag.html"

